# Client-safe Supabase config (fine to expose in the app bundle).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Local/manual tooling only. NEVER prefix with EXPO_PUBLIC_. ---
# Required only by scripts/seed-social-demo.js. Put the real value in a
# gitignored `.env.local` file, never in this tracked `.env`/`.env.example`.
# Find it in Supabase Dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: override the shared dev-only password used for all demo sellers.
DEMO_SELLER_PASSWORD=
